ES_URL=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=changeme
ES_INDEX_PREFIX=openhexa

# DVF : ingère un fichier national full.csv.gz par millésime, de DVF_YEAR_START à
# DVF_YEAR_END inclus. Laisser DVF_DATA_URL vide pour construire les URLs depuis ces
# millésimes ; ne renseigner DVF_DATA_URL que pour un override (une seule URL, ignore
# alors DVF_YEAR_START/DVF_YEAR_END).
DVF_YEAR_START=2021
DVF_YEAR_END=2025
DVF_DATA_URL=
DPE_DATA_URL=https://data.ademe.fr/data-fair/api/v1/datasets/meg-83tjwtg8dyz4vv7h1dqe

DVF_POLLING_INTERVAL_SECONDS=604800
DPE_POLLING_INTERVAL_SECONDS=86400

# in_process : les boucles de polling ci-dessus tournent dans le serveur web.
# job        : elles sont désactivées, l'ingestion étant assurée par
#              `python -m app.jobs.ingest --source all` sur un ordonnanceur
#              séparé (Azure Container Apps Job). Ne basculer qu'une fois cet
#              ordonnanceur en place, sinon plus rien n'alimente les index.
INGESTION_MODE=in_process
